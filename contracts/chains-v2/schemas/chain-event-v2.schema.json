{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Bozza locale CHAIN-PLAN-2.0 da proporre a plenora-contracts; nessuna ratifica o disponibilita runtime.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "plenora-chain-event-v2"
    },
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "event_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "state_revision": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "occurred_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "kind": {
      "enum": [
        "accepted",
        "step_state",
        "cancel_requested",
        "cancel_confirmed",
        "recovery_required",
        "result_persisted",
        "delivery_confirmed"
      ]
    },
    "step_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "enum": [
        "pending",
        "ready",
        "admitted",
        "running",
        "finalizing",
        "succeeded",
        "rejected",
        "failed",
        "cancel_requested",
        "cancelled",
        "requires_recovery",
        "blocked",
        "skipped",
        "partial"
      ]
    },
    "result_ref": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "contract",
    "schema_version",
    "run_id",
    "event_id",
    "sequence",
    "state_revision",
    "occurred_at",
    "kind",
    "step_id",
    "attempt",
    "state",
    "result_ref",
    "error"
  ]
}
