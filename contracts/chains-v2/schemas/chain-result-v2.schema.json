{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Bozza locale CHAIN-PLAN-2.0 da proporre a plenora-contracts; nessuna ratifica o disponibilita runtime.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "plenora-chain-result-v2"
    },
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "result_message_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "plan_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "plan_revision": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "plan_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "state_revision": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "state": {
      "enum": [
        "succeeded",
        "rejected",
        "failed",
        "cancelled",
        "requires_recovery",
        "partial"
      ]
    },
    "started_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "finished_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "counters": {
      "$ref": "common.schema.json#/$defs/counters"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/step_result"
      },
      "maxItems": 1024,
      "minItems": 1
    },
    "outputs": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/artifact"
      },
      "maxProperties": 64,
      "minProperties": 0
    },
    "error": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    },
    "other_errors": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/error"
      },
      "maxItems": 64,
      "minItems": 0
    },
    "remote_effect": {
      "$ref": "common.schema.json#/$defs/effect"
    },
    "retry": {
      "$ref": "common.schema.json#/$defs/retry"
    },
    "reports": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/report"
      },
      "maxItems": 1024,
      "minItems": 0
    },
    "reports_complete": {
      "type": "boolean"
    },
    "losses": {
      "enum": [
        "none",
        "present",
        "unavailable"
      ]
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "evidence_ref": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/opaque"
            },
            {
              "type": "null"
            }
          ]
        },
        "resumable_steps": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "maxItems": 1024,
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "required",
        "evidence_ref",
        "resumable_steps"
      ]
    },
    "delivery": {
      "enum": [
        "persisted",
        "confirmed",
        "unconfirmed"
      ]
    }
  },
  "required": [
    "contract",
    "schema_version",
    "run_id",
    "result_message_id",
    "plan_id",
    "plan_revision",
    "plan_digest",
    "state_revision",
    "state",
    "started_at",
    "finished_at",
    "counters",
    "steps",
    "outputs",
    "error",
    "other_errors",
    "remote_effect",
    "retry",
    "reports",
    "reports_complete",
    "losses",
    "recovery",
    "delivery"
  ]
}
