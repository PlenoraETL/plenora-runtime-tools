{
  "$schema": "../../schemas/runtime-negotiation-vector-v1.schema.json",
  "schema_version": 1,
  "contract": "plenora-runtime-negotiation-vector-v1",
  "description": "A hop cannot read the acceptance record, so it cannot tell a new request from a retry, a redrive or a resend: refused.",
  "request": "../runtime-v1/database-read-request.json",
  "ingress": {
    "minimum": null
  },
  "hops": [
    {
      "from": "sender",
      "record": "readable",
      "carries": true,
      "receives": {
        "requires": "plenora-runtime-binding-v2",
        "accepts_downgrade": false
      },
      "forwards": {
        "requires": "plenora-runtime-binding-v2",
        "accepts_downgrade": false
      }
    },
    {
      "from": "hop",
      "record": "unreadable",
      "carries": true,
      "receives": {
        "requires": "plenora-runtime-binding-v2",
        "accepts_downgrade": false
      },
      "forwards": null
    }
  ],
  "destination": {
    "interface": {
      "kind": "runtime",
      "contract": "plenora-runtime-binding-v2",
      "version": 2
    }
  },
  "expect": {
    "decision": "refuse",
    "at_hop": 1,
    "category": "unsupported",
    "phase": "validate",
    "remote_effect": "none",
    "retry": "never"
  }
}
