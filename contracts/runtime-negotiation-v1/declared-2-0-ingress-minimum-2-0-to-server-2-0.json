{
  "$schema": "../../schemas/runtime-negotiation-vector-v1.schema.json",
  "schema_version": 1,
  "contract": "plenora-runtime-negotiation-vector-v1",
  "description": "A sender states 2.0 at an ingress with a minimum requirement of 2.0; the destination advertises 2.0: sent.",
  "request": "../runtime-v1/database-read-request.json",
  "ingress": {
    "minimum": "plenora-runtime-binding-v2"
  },
  "hops": [
    {
      "from": "sender",
      "record": "readable",
      "carries": true,
      "receives": {
        "requires": "plenora-runtime-binding-v2",
        "accepts_downgrade": false
      },
      "forwards": {
        "requires": "plenora-runtime-binding-v2",
        "accepts_downgrade": false
      }
    },
    {
      "from": "hop",
      "record": "readable",
      "carries": true,
      "receives": {
        "requires": "plenora-runtime-binding-v2",
        "accepts_downgrade": false
      },
      "forwards": null
    }
  ],
  "destination": {
    "interface": {
      "kind": "runtime",
      "contract": "plenora-runtime-binding-v2",
      "version": 2
    }
  },
  "expect": {
    "decision": "send",
    "governed_by": "plenora-runtime-binding-v2"
  }
}
