{
  "$schema": "../../schemas/runtime-negotiation-vector-v1.schema.json",
  "schema_version": 1,
  "contract": "plenora-runtime-negotiation-vector-v1",
  "description": "A sender states 2.0 without downgrade; the only destination advertises 1.0. The request is the same bytes under both versions, so only the selection detects it: refused at the router, never downgraded implicitly.",
  "request": "../runtime-v1/database-read-request.json",
  "ingress": {
    "minimum": null
  },
  "hops": [
    {
      "from": "sender",
      "record": "readable",
      "carries": true,
      "receives": {
        "requires": "plenora-runtime-binding-v2",
        "accepts_downgrade": false
      },
      "forwards": {
        "requires": "plenora-runtime-binding-v2",
        "accepts_downgrade": false
      }
    },
    {
      "from": "hop",
      "record": "readable",
      "carries": true,
      "receives": {
        "requires": "plenora-runtime-binding-v2",
        "accepts_downgrade": false
      },
      "forwards": null
    }
  ],
  "destination": {
    "interface": {
      "kind": "runtime",
      "contract": "plenora-runtime-binding-v1",
      "version": 1
    }
  },
  "expect": {
    "decision": "refuse",
    "at_hop": 1,
    "category": "unsupported",
    "phase": "validate",
    "remote_effect": "none",
    "retry": "never"
  }
}
