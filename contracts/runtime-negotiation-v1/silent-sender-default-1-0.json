{
  "$schema": "../../schemas/runtime-negotiation-vector-v1.schema.json",
  "schema_version": 1,
  "contract": "plenora-runtime-negotiation-vector-v1",
  "description": "A sender states nothing and the ingress has no minimum requirement: the ingress attaches 1.0 without downgrade, the only default. The selection does not guarantee RT-024; the destination chosen here advertises 2.0 and still applies it. A sender of 2.0 that states nothing is indistinguishable from this one: the limit of RT-027.",
  "request": "../runtime-v1/database-read-request.json",
  "ingress": {
    "minimum": null
  },
  "hops": [
    {
      "from": "sender",
      "record": "readable",
      "carries": true,
      "receives": null,
      "forwards": {
        "requires": "plenora-runtime-binding-v1",
        "accepts_downgrade": false
      }
    },
    {
      "from": "hop",
      "record": "readable",
      "carries": true,
      "receives": {
        "requires": "plenora-runtime-binding-v1",
        "accepts_downgrade": false
      },
      "forwards": null
    }
  ],
  "destination": {
    "interface": {
      "kind": "runtime",
      "contract": "plenora-runtime-binding-v2",
      "version": 2
    }
  },
  "expect": {
    "decision": "send",
    "governed_by": "plenora-runtime-binding-v2"
  }
}
